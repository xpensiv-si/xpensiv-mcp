{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.xpensiv-si/xpensiv",
  "description": "Run Xpensiv design checks on a public page from your AI agent.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/xpensiv-si/xpensiv-mcp",
    "source": "github"
  },
  "website_url": "https://xpensiv.si",
  "packages": [
    {
      "registry_type": "npm",
      "identifier": "xpensiv-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environment_variables": [
        {
          "name": "XPENSIV_API_KEY",
          "description": "API key from https://xpensiv.si/console/keys",
          "is_secret": true,
          "is_required": true
        }
      ]
    }
  ]
}
